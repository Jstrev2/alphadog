# Copy to .env.local for local dev, or run `npx vercel env pull .env.local`
# once the values live in Vercel. Never commit real values.

# Supabase (Postgres + PostGIS + Auth). Added when the database is set up.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Map tiles. Leave blank to use the free OpenFreeMap style.
NEXT_PUBLIC_MAP_STYLE_URL=
