# Copy to .env.local and fill in for local development.
# Production values live in the Vercel project settings.
# Never commit real values.

# Supabase project URL and publishable (browser-safe) key. Ask Jon for these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Base map style. Leave blank to use the free OpenFreeMap style
# (OpenStreetMap data, no key needed).
NEXT_PUBLIC_MAP_STYLE_URL=
